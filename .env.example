# Server-only Stripe key. Use test mode until payment and delivery are verified.
NUXT_STRIPE_SECRET_KEY=
NUXT_SITE_URL=http://localhost:3000
# Optional stable random signing secret for 180-day download links.
# If omitted, links use the Stripe key and expire when that key changes.
NUXT_FONT_DOWNLOAD_SECRET=

# Private Cloudflare R2 bucket for shared poster images.
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=
